# --- Banco de dados (Postgres + PGVector) ---
POSTGRES_USER=ragdocs
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=ragdocs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- LLM (Groq — free tier, zero custo) ---
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# --- Observabilidade ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragdocs-enterprise

# --- Fontes externas ---
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
NOTION_TOKEN=

# --- Segurança da API ---
API_AUTH_MODE=api_key         
API_KEY=change_me_local_dev_key

# --- App ---
APP_ENV=development            
LOG_LEVEL=INFO